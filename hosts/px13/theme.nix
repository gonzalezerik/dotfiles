# px13-blue: the muted "GoPro" blue/cyan of the PX13 GoPro Edition keyboard.
# primary / secondary are the wallpaper's major / minor contour lines.
{
  slug = "px13-blue";
  gnomeAccent = "blue";

  primary = "#87ABC0";
  onPrimary = "#0A1116";
  secondary = "#3F5875";
  onSecondary = "#E8EEF2";
  tertiary = "#6C93A6"; # midpoint of the two line colours
  onTertiary = "#0A1116";
  error = "#C1666B"; # muted rose, kept low-saturation to fit
  onError = "#0A1116";
  surface = "#0A0D10"; # near-black with a blue cast
  onSurface = "#C9D6DE";
  surfaceVariant = "#141B22";
  onSurfaceVariant = "#9DB0BD";
  outline = "#3F5875";
  shadow = "#000000";
  hover = "#1E2A35";
  onHover = "#E8EEF2";
  success = "#7FA37A"; # git clean, diagnostics hints

  ansi = {
    black = "#10161B";
    red = "#C1666B";
    green = "#7FA37A";
    yellow = "#C9A46A";
    blue = "#3F5875";
    magenta = "#8C7AA6";
    cyan = "#87ABC0";
    white = "#C9D6DE";
  };
  ansiBright = {
    black = "#46525C";
    red = "#D98A8E";
    green = "#9FC29A";
    yellow = "#E0C08A";
    blue = "#6C93A6";
    magenta = "#AA9BC2";
    cyan = "#A9CBDD";
    white = "#E8EEF2";
  };
}
